# Copy to .env. Never commit credentials. All models run on CPU except API inference.
DATA_DIR=data
HOST=0.0.0.0
PORT=7860
API_TOKEN=
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
SMALL_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=4096
SMALL_INPUT_USD_MILLION=
SMALL_OUTPUT_USD_MILLION=
LARGE_INPUT_USD_MILLION=
LARGE_OUTPUT_USD_MILLION=
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION=evidencegraph_x_v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_THREADS=2
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
REDIS_URL=
PARSER=pymupdf
MAX_UPLOAD_MB=30
MAX_PAGES=400
CHUNK_WORDS=140
PARENT_WORDS=700
RETRIEVAL_K=30
RERANKER_K=8
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
USE_RERANKER=true
GRAPH_ENABLED=true
GRAPH_CHUNK_LIMIT=0
GRAPH_HOPS=2
GRAPH_LIMIT=1000
CACHE_THRESHOLD=0.98
SEMANTIC_CACHE=false
CACHE_TTL=3600
CACHE_ENTRIES=50
GRADE_THRESHOLD=0.65
MAX_CONTEXT_CHARS=26000
USE_HYDE=false
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=
# Deployment only: public DNS name for Caddy. No scheme or slash.
PUBLIC_HOST=
